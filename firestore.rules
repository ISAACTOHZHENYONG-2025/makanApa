rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Student Food Intelligence: Public read-only access for all students (no login required)
    // Venues are written only by the db:* scripts through the Admin SDK, which bypasses these rules
    match /venues/{venueId} {
      allow read: if true;
      allow write: if false;
    }

    // Group decision rooms: anyone can open a room and join it, but nobody can edit or delete entries
    match /group_rooms/{roomId} {
      allow read, create: if true;

      match /participants/{participantId} {
        allow read, create: if true;
      }
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}

